{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mangamotion.local/schema/motionscript-v1.schema.json",
  "title": "MotionScript v1 (PRD section 6)",
  "type": "object", "additionalProperties": false,
  "required": ["version", "chapter", "direction", "characters", "pages"],
  "properties": {
    "version": {"const": 1}, "chapter": {"type":"string","minLength":1},
    "direction": {"enum":["rtl","ltr"]},
    "characters": {"type":"object","additionalProperties":{"type":"object","required":["voice"],"additionalProperties":false,"properties":{"voice":{"type":"string"},"name":{"type":"string"}}}},
    "pages": {"type":"array","minItems":1,"items":{"$ref":"#/definitions/page"}}
  },
  "definitions": {
    "rect": {"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0}},
    "path": {"type":"string","pattern":"^(pages|audio|sfx)/[A-Za-z0-9_.-]+$"},
    "page": {"type":"object","additionalProperties":false,"required":["id","image","size","panels"],"properties":{
      "id":{"type":"string"},"image":{"$ref":"#/definitions/path"},"size":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1}},
      "panels":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/panel"}}
    }},
    "panel": {"type":"object","additionalProperties":false,"required":["id","bbox","director","timeline","transition_out","confidence"],"properties":{
      "id":{"type":"string"},"bbox":{"$ref":"#/definitions/rect"},
      "director":{"type":"object","additionalProperties":false,"required":["beat","shot","energy","mood","time_skip","focus"],"properties":{
        "beat":{"enum":["establish","dialogue","reaction","reveal","impact","chase","comedy","flashback","quiet","transition"]},
        "shot":{"enum":["wide","medium","closeup","extreme_closeup","splash","insert"]},
        "energy":{"type":"number","minimum":0,"maximum":1},"mood":{"type":"array","items":{"type":"string"}},"time_skip":{"type":"boolean"},
        "focus":{"type":"array","items":{"type":"object","required":["kind","bbox"],"additionalProperties":false,"properties":{"kind":{"enum":["face","object","bubble","region"]},"ref":{"type":"string"},"char":{"type":"string"},"bbox":{"$ref":"#/definitions/rect"}}}}
      }},
      "timeline":{"type":"array","minItems":1,"items":{"oneOf":[{"$ref":"#/definitions/camera"},{"$ref":"#/definitions/line"},{"$ref":"#/definitions/sfx"}]}},
      "transition_out":{"type":"object","required":["type","dur"],"additionalProperties":false,"properties":{"type":{"enum":["glide","cut","fade","whip","dissolve","dip"]},"dur":{"type":"number","minimum":0,"maximum":0.6}}},
      "confidence":{"type":"object","required":["panel","ocr","speaker"],"additionalProperties":false,"properties":{"panel":{"type":["number","null"],"minimum":0,"maximum":1},"ocr":{"type":["number","null"],"minimum":0,"maximum":1},"speaker":{"type":["number","null"],"minimum":0,"maximum":1}}}
    }},
    "camera":{"type":"object","additionalProperties":false,"required":["t","type","move","from","to","dur","ease"],"properties":{"t":{"type":"number","minimum":0},"type":{"const":"camera"},"move":{"enum":["push_in","pull_out","pan","hold"]},"from":{"$ref":"#/definitions/rect"},"to":{"$ref":"#/definitions/rect"},"dur":{"type":"number","exclusiveMinimum":0},"ease":{"enum":["linear","outQuad","inOutSine"]}}},
    "line":{"type":"object","additionalProperties":false,"required":["t","type","bubble","speaker","text","audio","dur","emotion","highlight"],"properties":{"t":{"type":"number","minimum":0},"type":{"const":"line"},"bubble":{"type":"string"},"speaker":{"type":"string"},"text":{"type":"string"},"audio":{"$ref":"#/definitions/path"},"dur":{"type":"number","exclusiveMinimum":0},"emotion":{"type":"object","additionalProperties":false,"required":["delivery","intensity"],"properties":{"delivery":{"enum":["speak","shout","whisper","think","narrate","cry","laugh"]},"intensity":{"type":"number","minimum":0,"maximum":1}}},"highlight":{"type":"boolean"}}},
    "sfx":{"type":"object","additionalProperties":false,"required":["t","type","file","gain_db"],"properties":{"t":{"type":"number","minimum":0},"type":{"const":"sfx"},"file":{"$ref":"#/definitions/path"},"gain_db":{"type":"number","minimum":-60,"maximum":0}}}
  }
}
